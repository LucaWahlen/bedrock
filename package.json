    "build:cli": "bun build scripts/admin/index.ts scripts/migrate/index.ts scripts/housekeeping/index.ts --target node --outdir dist/cli --entry-naming '[dir].mjs' --chunk-naming 'chunks/[name]-[hash].mjs' --splitting --loader .css:text --define process.env.NODE_ENV=globalThis.process.env.NODE_ENV",
