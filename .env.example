# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# Authentication (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://app.example.com

# Seed Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# S3-compatible object storage
S3_REGION=auto
S3_BUCKET=bedrock-media
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=https://media.example.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Housekeeping
HOUSEKEEPING_RUN_ONCE=false
HOUSEKEEPING_RUN_ON_START=false
AUDIT_RETENTION_DAYS=90

# Transactional email
# console renders the mail to the log, smtp sends it. Any provider with SMTP
# credentials works here, Resend included.
EMAIL_SENDER_NAME=Bedrock
EMAIL_SENDER_ADDRESS=no-reply@example.com
EMAIL_REPLY_TO_ADDRESS=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Password Leak Check
PWNED_PASSWORD_CHECK=true

GIT_COMMIT=
SOURCE_COMMIT=